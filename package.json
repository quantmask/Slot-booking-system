{
  "name": "slotbook",
  "version": "1.0.0",
  "description": "High-reliability Calendly-style scheduler with concurrency guarantees backed by Postgres",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev --prefix backend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "test": "npm run test --prefix backend",
    "test:concurrency": "npm run test:concurrency --prefix backend",
    "test:edge": "npm run test:edge --prefix backend",
    "benchmark": "npm run benchmark --prefix backend",
    "generate:pdf": "node scripts/generate_report_pdf.js",
    "start": "npm run start --prefix backend"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/static": "^8.1.1",
    "@types/pdfkit": "^0.17.7",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "lucide-react": "^1.16.0",
    "luxon": "^3.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
